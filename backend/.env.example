# PG Finder AI - Backend Configuration

# Database Configuration (SQLite)
# Automatically creates tables in backend/pg_finder.db on startup
DATABASE_URL=sqlite:///./pg_finder.db

# Local Ollama Model Configuration
# Default model installed and verified: llama3.2:3b
OLLAMA_MODEL=llama3.2:3b

# Local Ollama Service Endpoint (default for Ollama on Windows)
OLLAMA_HOST=http://localhost:11434

# Backend Server Host & Port
HOST=127.0.0.1
PORT=8000

# Allowed Frontend Origins for CORS (comma-separated or single URL)
FRONTEND_URL=http://localhost:3000
